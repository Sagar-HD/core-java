<!DOCTYPE html>
<html>
<head>
    <title>Feedback</title>
</head>
<body>

<h2>Feedback Form</h2>

<form action="feedback" method="post">




    <label>Mobile:</label>
    <input type="tel" name="mobile" required>
    <br><br>

    <label>Comment:</label>
    <br>
    <textarea name="comment" rows="5" cols="30" required></textarea>
    <br><br>

    <button type="submit">Submit Feedback</button>

</form>

</body>
</html>