<!DOCTYPE html>
<html>
<head>
    <title>Sign In</title>
</head>
<body>

<h2>Sign In</h2>

<form action="login" method="post">

    <label>Name:</label>
    <input type="text" name="name" required>
    <br><br>

    <label>Password:</label>
    <input type="password" name="password" required>
    <br><br>

    <button type="submit">Sign In</button>

</form>

</body>
</html>